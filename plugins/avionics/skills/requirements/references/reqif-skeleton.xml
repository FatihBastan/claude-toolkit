<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal ReqIF 1.2 skeleton for requirement export (DOORS Next / DOORS Classic ReqIF import).
  Fill it with a script, never by hand:
    - one SPEC-OBJECT per requirement, one SPEC-RELATION per parent link (source = child, target = parent),
    - one SPEC-HIERARCHY per requirement in the document order.
  IDENTIFIERs must be unique and stable: derive them from the requirement ID (e.g. "REQ-HMI-RT-LLR-012"),
  never from a random UUID, so re-exports stay diff-able.
  LAST-CHANGE / CREATION-TIME: use the requirement set's release date, not "now", so the output is deterministic.
  If the importer wants rich text, switch the text attribute to DATATYPE-DEFINITION-XHTML.
-->
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd">
  <THE-HEADER>
    <REQ-IF-HEADER IDENTIFIER="HDR-{{SET}}">
      <CREATION-TIME>{{RELEASE_DATE}}T00:00:00Z</CREATION-TIME>
      <REQ-IF-TOOL-ID>{{EXPORT_SCRIPT_NAME_AND_VERSION}}</REQ-IF-TOOL-ID>
      <REQ-IF-VERSION>1.0</REQ-IF-VERSION>
      <SOURCE-TOOL-ID>{{EXPORT_SCRIPT_NAME_AND_VERSION}}</SOURCE-TOOL-ID>
      <TITLE>{{SET_TITLE}}</TITLE>
    </REQ-IF-HEADER>
  </THE-HEADER>
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="DT-STRING" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z" LONG-NAME="String" MAX-LENGTH="32000"/>
      </DATATYPES>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="SOT-REQUIREMENT" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z" LONG-NAME="Requirement">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-ID" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z" LONG-NAME="ID">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-TEXT" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z" LONG-NAME="Object Text">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-VERIFICATION" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z" LONG-NAME="Verification Method">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-DERIVED" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z" LONG-NAME="Derived">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-RATIONALE" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z" LONG-NAME="Derivation Rationale">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-STATUS" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z" LONG-NAME="Status">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
        <SPEC-RELATION-TYPE IDENTIFIER="SRT-TRACES-TO" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z" LONG-NAME="traces to parent"/>
        <SPECIFICATION-TYPE IDENTIFIER="ST-MODULE" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z" LONG-NAME="Requirement module"/>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <!-- repeat per requirement -->
        <SPEC-OBJECT IDENTIFIER="REQ-{{ID}}" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z">
          <TYPE><SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="{{ID}}">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="{{TEXT}}">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="{{VERIFICATION_METHOD}}">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-VERIFICATION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="{{DERIVED}}">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-DERIVED</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="{{DERIVATION_RATIONALE}}">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-RATIONALE</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="{{STATUS}}">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-STATUS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
        </SPEC-OBJECT>
      </SPEC-OBJECTS>
      <SPEC-RELATIONS>
        <!-- repeat per parent link: source = the child requirement, target = its parent -->
        <SPEC-RELATION IDENTIFIER="REL-{{ID}}-{{PARENT_ID}}" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z">
          <TYPE><SPEC-RELATION-TYPE-REF>SRT-TRACES-TO</SPEC-RELATION-TYPE-REF></TYPE>
          <SOURCE><SPEC-OBJECT-REF>REQ-{{ID}}</SPEC-OBJECT-REF></SOURCE>
          <TARGET><SPEC-OBJECT-REF>REQ-{{PARENT_ID}}</SPEC-OBJECT-REF></TARGET>
        </SPEC-RELATION>
      </SPEC-RELATIONS>
      <SPECIFICATIONS>
        <SPECIFICATION IDENTIFIER="SPEC-{{SET}}" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z" LONG-NAME="{{SET_TITLE}}">
          <TYPE><SPECIFICATION-TYPE-REF>ST-MODULE</SPECIFICATION-TYPE-REF></TYPE>
          <CHILDREN>
            <!-- repeat per requirement, in document order -->
            <SPEC-HIERARCHY IDENTIFIER="H-{{ID}}" LAST-CHANGE="{{RELEASE_DATE}}T00:00:00Z">
              <OBJECT><SPEC-OBJECT-REF>REQ-{{ID}}</SPEC-OBJECT-REF></OBJECT>
            </SPEC-HIERARCHY>
          </CHILDREN>
        </SPECIFICATION>
      </SPECIFICATIONS>
    </REQ-IF-CONTENT>
  </CORE-CONTENT>
</REQ-IF>
